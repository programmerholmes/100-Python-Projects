# Copy this file to ".env" and fill in your values.
#
# Get a FREE Stripe TEST secret key here (no charges are ever made in test mode):
#   https://dashboard.stripe.com/test/apikeys
# It starts with "sk_test_". Only the secret key is needed for Stripe Checkout.
#
# If you leave STRIPE_SECRET_KEY blank, the site uses a built-in demo checkout,
# so everything still works — you just won't hit the real Stripe payment page.

STRIPE_SECRET_KEY=

# Any random string; used to sign session cookies.
FLASK_SECRET_KEY=please-change-this-to-something-random
